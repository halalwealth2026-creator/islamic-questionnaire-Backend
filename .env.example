NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/IslamicForm?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
# Optional: instead of ADMIN_PASSWORD, you may provide a bcrypt hash via `npm run hash-password`:
# ADMIN_PASSWORD_HASH=paste-bcrypt-hash-here
FRONTEND_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000
